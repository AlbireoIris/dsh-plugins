+import type { ReasoningEffortId } from '@deepseek-ai/dsh-llm'
 import type { ContentBlock } from '@deepseek-ai/dsh-llm/types'
 import type { SessionId } from '@deepseek-ai/dsh-session/types'
 
@@ -168,6 +169,18 @@ export interface SpawnTeammateRequest {
   readonly prompt: ContentBlock[]
   readonly context: 'fresh' | 'fork'
   readonly provider: string
+  /**
+   * Optional per-teammate model. Omitting it inherits the Team Lead's model;
+   * naming one runs this teammate on its own model, which is what lets a
+   * reviewer use a different model from a producer.
+   */
+  readonly model?: string
+  /**
+   * Optional per-teammate reasoning effort. Imported from `dsh-llm` rather than
+   * `dsh-agent` so this types module stays on the shallow type-only dependency
+   * face the Client projection already contains.
+   */
+  readonly reasoningEffort?: ReasoningEffortId
   readonly signal: AbortSignal
 }
 
