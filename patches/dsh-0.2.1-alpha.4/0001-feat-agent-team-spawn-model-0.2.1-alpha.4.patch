         request: {
           prompt: request.prompt,
           parent: root,
+          // Only override the child's route when the caller named one: omitting
+          // both keeps `resolveChildAgentOptions` inheriting the Team Lead's
+          // route, which is the existing behavior.
+          agentOptions: {
+            ...request.model === undefined ? {} : { model: request.model },
